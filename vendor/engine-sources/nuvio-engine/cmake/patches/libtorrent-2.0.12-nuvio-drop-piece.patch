+	// nuvio (#334): streaming window. The disk back-end already punched the
+	// piece out of the file, so it must stop being "have": otherwise reads
+	// would serve a hole to the player or to peers.
+	void torrent::nuvio_drop_piece(piece_index_t const piece)
+	{
+		if (!valid_metadata() || piece < piece_index_t(0)
+			|| piece >= m_torrent_file->end_piece())
+			return;
+		if (!has_picker() && !m_have_all) return;
+		need_picker();
+		m_have_all = false;
+		if (!m_picker->have_piece(piece)) return;
+		m_picker->we_dont_have(piece);
+		inc_stats_counter(counters::num_have_pieces, -1);
+		// file_progress has no "lost a piece": rebuild it from the picker
+		if (!m_file_progress.empty())
+		{
+			m_file_progress.clear();
+			m_file_progress.init(*m_picker, m_torrent_file->files());
+		}
+		for (auto c : m_connections)
+		{
+			TORRENT_INCREMENT(m_iterating_connections);
+			if (c->is_disconnecting()) continue;
+			c->reject_piece(piece);
+			c->write_dont_have(piece);
+		}
+		update_gauge();
+		set_need_save_resume(torrent_handle::if_download_progress);
+		state_updated();
+		update_want_tick();
+	}
