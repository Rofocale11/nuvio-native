+	// nuvio: the storage moved to an empty folder (the old one vanished with
+	// its drive). Whole pieces become "not have", partial ones start over (their
+	// first blocks went with the old folder), and a disk error that paused the
+	// torrent while the drive was going is cleared.
+	void torrent::nuvio_forget_all()
+	{
+		if (m_error)
+		{
+			clear_error();
+			if (is_paused()) resume();
+		}
+		if (m_upload_mode) set_upload_mode(false);
+		if (!valid_metadata()) return;
+		if (!has_picker() && !m_have_all) return;
+		need_picker();
+		m_have_all = false;
+		for (auto const& dp : m_picker->get_download_queue())
+			m_picker->restore_piece(dp.index);
+		for (piece_index_t i(0); i < m_torrent_file->end_piece(); ++i)
+		{
+			if (!m_picker->have_piece(i)) continue;
+			m_picker->we_dont_have(i);
+			inc_stats_counter(counters::num_have_pieces, -1);
+			for (auto c : m_connections)
+			{
+				TORRENT_INCREMENT(m_iterating_connections);
+				if (c->is_disconnecting()) continue;
+				c->write_dont_have(i);
+			}
+		}
+		if (!m_file_progress.empty())
+		{
+			m_file_progress.clear();
+			m_file_progress.init(*m_picker, m_torrent_file->files());
+		}
+		update_gauge();
+		set_need_save_resume(torrent_handle::if_download_progress);
+		state_updated();
+		update_want_tick();
+	}
