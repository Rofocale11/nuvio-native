+void EngineRuntime::set_streaming_window(const std::uint64_t bytes) {
+    backend_->set_streaming_window(bytes);
+}
+bool EngineRuntime::apply_setting(const char* const name, const int value) {
+    return backend_->apply_setting(name, value);
+}
+nuvio_engine_status EngineRuntime::relocate(std::string cache_directory, const std::uint64_t segment_bytes) {
+    Command command{};
+    command.type = CommandType::relocate;
+    command.torrent_id = std::move(cache_directory);
+    command.target_bytes = segment_bytes;
+    std::uint64_t request_id = 0;
+    return enqueue(std::move(command), request_id);
+}
