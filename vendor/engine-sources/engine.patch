+nuvio_engine_status nuvio_engine_set_rate_limits(
+    nuvio_engine* const engine,
+    const std::uint64_t download_bytes_per_second,
+    const std::uint64_t upload_bytes_per_second
+) {
+    if (engine == nullptr) {
+        return NUVIO_ENGINE_STATUS_INVALID_ARGUMENT;
+    }
+    try {
+        engine->runtime->set_rate_limits(download_bytes_per_second, upload_bytes_per_second);
+        return NUVIO_ENGINE_STATUS_OK;
+    } catch (...) {
+        return NUVIO_ENGINE_STATUS_INITIALIZATION_FAILED;
+    }
+}
+
+nuvio_engine_status nuvio_engine_set_streaming_window(
+    nuvio_engine* const engine,
+    const std::uint64_t streaming_window_bytes
+) {
+    if (engine == nullptr) {
+        return NUVIO_ENGINE_STATUS_INVALID_ARGUMENT;
+    }
+    if (engine->streaming_window_bytes == 0 || streaming_window_bytes == 0) {
+        return NUVIO_ENGINE_STATUS_OK;
+    }
+    try {
+        engine->runtime->set_streaming_window(std::max<std::uint64_t>(
+            streaming_window_bytes,
+            NUVIO_ENGINE_MINIMUM_STREAMING_WINDOW_BYTES
+        ));
+        return NUVIO_ENGINE_STATUS_OK;
+    } catch (...) {
+        return NUVIO_ENGINE_STATUS_INITIALIZATION_FAILED;
+    }
+}
+
+nuvio_engine_status nuvio_engine_relocate(
+    nuvio_engine* const engine,
+    const char* const cache_directory,
+    const std::uint64_t segment_bytes
+) {
+    if (engine == nullptr || cache_directory == nullptr || cache_directory[0] == '\0') {
+        return NUVIO_ENGINE_STATUS_INVALID_ARGUMENT;
+    }
+    try {
+        return engine->runtime->relocate(cache_directory, segment_bytes);
+    } catch (...) {
+        return NUVIO_ENGINE_STATUS_INITIALIZATION_FAILED;
+    }
+}
+
+nuvio_engine_status nuvio_engine_apply_setting(
+    nuvio_engine* const engine,
+    const char* const name,
+    const int value
+) {
+    if (engine == nullptr || name == nullptr) {
+        return NUVIO_ENGINE_STATUS_INVALID_ARGUMENT;
+    }
+    try {
+        return engine->runtime->apply_setting(name, value)
+            ? NUVIO_ENGINE_STATUS_OK
+            : NUVIO_ENGINE_STATUS_INVALID_ARGUMENT;
+    } catch (...) {
+        return NUVIO_ENGINE_STATUS_INITIALIZATION_FAILED;
+    }
+}
